{
  "manifest_version": 1,
  "type": "tts",
  "name": "Google Translate TTS",
  "description": {
    "en": "The free voice of Google Translate for Gladys announcements: no account, no API key.",
    "fr": "La voix gratuite de Google Traduction pour les annonces de Gladys : sans compte ni clé d'API.",
    "de": "Die kostenlose Stimme von Google Übersetzer für Ansagen von Gladys: ohne Konto, ohne API-Schlüssel.",
    "es": "La voz gratuita de Google Traductor para los anuncios de Gladys: sin cuenta ni clave de API."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-google-translate-tts:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-google-translate-tts/main/cover.png",
  "categories": ["assistants"],
  "keywords": [
    "google translate",
    "google traduction",
    "gtts",
    "tts",
    "text-to-speech",
    "synthèse vocale",
    "voix",
    "voice"
  ],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "The free voice of Google Translate",
        "fr": "La voix gratuite de Google Traduction",
        "de": "Die kostenlose Stimme von Google Übersetzer",
        "es": "La voz gratuita de Google Traductor"
      },
      "description": {
        "en": "No account or key: the voice of the Google Translate website, as with gTTS. Unofficial and without guarantee: Google may change or limit it. Texts are sent to Google. Then select this voice on the Artificial Intelligence page.",
        "fr": "Sans compte ni clé : la voix du site Google Traduction, comme gTTS. Non officielle et sans garantie : Google peut la changer ou la limiter. Les textes sont envoyés à Google. Choisissez ensuite cette voix sur la page Intelligence Artificielle.",
        "de": "Ohne Konto und Schlüssel: die Stimme der Website Google Übersetzer, wie bei gTTS. Inoffiziell und ohne Garantie: Google kann sie ändern oder begrenzen. Die Texte gehen an Google. Wähle die Stimme dann auf der Seite Künstliche Intelligenz.",
        "es": "Sin cuenta ni clave: la voz del sitio Google Traductor, como gTTS. No oficial y sin garantía: Google puede cambiarla o limitarla. Los textos se envían a Google. Después, elija esta voz en la página Inteligencia artificial."
      },
      "links": [
        {
          "url": "https://policies.google.com/privacy",
          "label": {
            "en": "Google privacy policy",
            "fr": "Règles de confidentialité de Google",
            "de": "Datenschutzerklärung von Google",
            "es": "Política de privacidad de Google"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the voice",
        "fr": "Langue de la voix",
        "de": "Sprache der Stimme",
        "es": "Idioma de la voz"
      },
      "description": {
        "en": "Automatic: the language of the user Gladys answers, or of the first administrator for an announcement (French when unknown).",
        "fr": "Automatique : la langue de l'utilisateur à qui Gladys répond, ou du premier administrateur pour une annonce (français si inconnue).",
        "de": "Automatisch: die Sprache des Benutzers, dem Gladys antwortet, bei einer Ansage die des ersten Administrators (sonst Französisch).",
        "es": "Automático: el idioma del usuario al que responde Gladys, o del primer administrador para un anuncio (francés si se desconoce)."
      },
      "required": false,
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": {
